{
  "name": "nazca-railway-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop shell for the Nazca Railway static reader",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "start:dev": "set NAZCA_DESKTOP_DEV_URL=http://127.0.0.1:3000&& electron .",
    "check": "node --check src/main.mjs && node --check src/preload.mjs",
    "package:squirrel": "node ../scripts/desktop/package-squirrel.mjs",
    "install:electron": "npm install --ignore-scripts --no-save electron@43.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3"
  },
  "build": {
    "appId": "org.dingdingprojects.nazca",
    "productName": "Nazca Railway",
    "asar": true,
    "compression": "maximum",
    "forceCodeSigning": false,
    "signAndEditExecutable": false,
    "directories": {
      "app": ".",
      "output": "../dist/desktop",
      "buildResources": "packaging/assets"
    },
    "files": [
      "**/*",
      "!**/{.git,.cache,coverage,dist,out}/**",
      "!**/{test,tests,__tests__}/**"
    ],
    "extraResources": [
      {
        "from": "../dist/client",
        "to": "site"
      }
    ],
    "win": {
      "target": [
        {
          "target": "squirrel",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "squirrelWindows": {
      "msi": false,
      "artifactName": "Nazca-Railway-${version}-Setup.exe"
    }
  }
}
