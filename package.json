{
  "name": "nazca-railway",
  "version": "0.1.0",
  "private": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "postbuild": "node scripts/check-static-bundle.mjs && node scripts/check-feature-coverage.mjs && node scripts/check-search-surfaces.mjs",
    "build:pages": "node scripts/run-vinext.mjs build --pages",
    "postbuild:pages": "node scripts/check-static-bundle.mjs --pages && node scripts/check-feature-coverage.mjs && node scripts/check-search-surfaces.mjs",
    "build:offline": "node scripts/run-vinext.mjs build --static",
    "postbuild:offline": "node scripts/check-static-bundle.mjs && node scripts/check-feature-coverage.mjs && node scripts/check-search-surfaces.mjs",
    "import:inventory": "node scripts/import-fandom.mjs",
    "check:no-lfs": "node scripts/check-no-git-lfs.mjs",
    "check:coverage": "node scripts/check-feature-coverage.mjs && node scripts/check-search-surfaces.mjs",
    "check:coverage:self-test": "node scripts/check-feature-coverage.mjs --self-test && node scripts/check-search-surfaces.mjs --self-test",
    "count:lines": "node scripts/count-lines.mjs",
    "package:offline": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-offline-bundle.ps1",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "fast-xml-parser": "5.11.1",
    "file-type": "22.0.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "marked": "18.0.11",
    "p-limit": "7.3.2",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "sanitize-html": "2.17.7",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "type": "module"
}
